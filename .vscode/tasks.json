{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MedicControl+: Validate all",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\validate.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "MedicControl+: Backend tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q",
        "--disable-warnings",
        "-x",
        "backend\\tests",
        "--basetemp",
        "${workspaceFolder}\\.tmp\\pytest"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}\\backend"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MedicControl+: Frontend tests",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "test",
        "--prefix",
        "frontend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MedicControl+: Frontend lint",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "lint",
        "--prefix",
        "frontend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MedicControl+: Frontend build",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "build",
        "--prefix",
        "frontend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "MedicControl+: Start backend",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}\\backend"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "MedicControl+: Start frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
